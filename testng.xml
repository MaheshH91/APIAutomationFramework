<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise API Automation Suite" parallel="classes" thread-count="2" verbose="2">

	<!-- Suite-Level XML Parameters -->
	<parameter name="environment" value="dev" />
	<parameter name="defaultTimeout" value="5000" />

	<!-- Listeners: TestListener (ExtentReports) & AnnotationTransformer (Auto-Retry) -->
	<listeners>
		<listener class-name="com.api.listeners.TestListener" />
		<listener class-name="com.api.listeners.AnnotationTransformer" />
	</listeners>

	<test name="API Functional and Security Tests">
		<classes>
			<class name="com.api.tests.LoginTest" />
			<class name="com.api.tests.AccountCreationTest" />
			<class name="com.api.tests.GetProfileRequestTest" />
			<class name="com.api.tests.UpdateProfileTest" />
			<class name="com.api.tests.AuthNegativeTest" />
			<class name="com.api.tests.UserProfileSecurityTest" />
			<class name="com.api.tests.UserLifecycleE2ETest" />
			<class name="com.api.tests.AuthorizationMechanismsTest" />
			<class name="com.api.tests.AdvancedApiTestingScenariosTest" />
			<class name="com.api.tests.ForgotPasswordTest" />
		</classes>
	</test>

	<test name="TestNG Advanced Features and Concurrency Test">
		<classes>
			<class name="com.api.tests.ComprehensiveTestNGFeaturesTest" />
		</classes>
	</test>

</suite>