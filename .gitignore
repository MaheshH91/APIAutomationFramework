# ==============================================================================
# Enterprise REST Assured API Automation Framework - .gitignore
# ==============================================================================

# --------------------------------------------------
# Maven Build & Target Directories
# --------------------------------------------------
target/
*.war
*.ear
*.nar
*.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --------------------------------------------------
# Execution Logs & Test Outputs
# --------------------------------------------------
logs/
*.log
mockoon.log
test-output/
surefire-reports/

# --------------------------------------------------
# HTML & Visual Test Reports (Local Artifacts)
# --------------------------------------------------
extent-reports/
*.html

# --------------------------------------------------
# Local Environment Overrides & Secret Properties
# --------------------------------------------------
config.local.properties
*.secret.properties
.env
.env.local
*.crt
*.pem
*.jks

# --------------------------------------------------
# IDE & Code Editor Metadata
# --------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
bin/

# Visual Studio Code
.vscode/
*.code-workspace

# --------------------------------------------------
# Operating System & Temporary Files
# --------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux / Vim
*~
*.swp
*.swo

# --------------------------------------------------
# Crash Dumps & Heap Files
# --------------------------------------------------
*.hprof
hs_err_pid*
replay_pid*
